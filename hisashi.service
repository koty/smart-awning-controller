[Unit]
Description=Hisashi Awning Automation Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=koty
WorkingDirectory=/home/koty/hisashi-ctl
ExecStart=/usr/bin/python3 /home/koty/hisashi-ctl/hisashi_daemon.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
